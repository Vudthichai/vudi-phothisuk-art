  "blocks": [
    {
      "selector": ".sqs-html-content (index 0)",
      "html": "<div class=\"sqs-html-content\" data-sqsp-text-block-content=\"\"><div class=\"sqsrte-scaled-text-container\"><span class=\"sqsrte-scaled-text\"><h1 style=\"white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">The Regal Collection</span></h1></span></div></div>",
      "text": "The Regal Collection"
    },
    {
      "selector": ".sqs-html-content (index 1)",
      "html": "<div class=\"sqs-html-content\" data-sqsp-text-block-content=\"\"><p class=\"\" style=\"white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">This collection is a journey through memory and emotion. Each piece is a singular moment—an invitation to step into worlds of refined texture, shadows, and color. These are not just paintings, but lived experiences and learned values.</span></p><p class=\"\" style=\"white-space:pre-wrap;\"><span class=\"sqsrte-text-color--accent\">The Regal Collection is where presence meets purpose: luxury without distance, intimacy without attachment. It’s sovereignty framed in paint and texture.</span></p></div>",
