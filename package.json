{
  "name": "vudi-phothisuk-art",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-ar-assets.mjs && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .prerender && node scripts/write-sharing-pages.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:seo": "node --test scripts/check-seo.mjs",
    "test:coa": "node scripts/check-coa.mjs",
    "test:http": "node scripts/check-http.mjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:studio-sandbox": "node --test scripts/check-studio-sandbox.mjs",
    "test:ar": "node scripts/check-ar-assets.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^30.1.3",
    "typescript": "~5.9.3",
    "vite": "^7.2.0",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
